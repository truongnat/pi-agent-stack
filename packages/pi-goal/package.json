{
	"name": "pi-goal",
	"version": "0.1.0",
	"description": "Multi-turn autonomous goal loop extension for the Pi coding agent",
	"keywords": [
		"pi-package",
		"pi-extension",
		"goal",
		"autonomous",
		"agent-loop"
	],
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"lint": "oxlint",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "tsc --noEmit",
		"test": "node --experimental-strip-types --test test/*.test.ts",
		"check": "bun run typecheck && bun run lint && bun run format:check && bun test"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^0.87.1",
		"@types/node": "^24.0.0",
		"oxlint": "1.78.0",
		"prettier": "3.9.6",
		"typebox": "^1.1.2",
		"typescript": "^5.9.0"
	}
}
