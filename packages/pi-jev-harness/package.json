{
	"name": "pi-jev-harness",
	"version": "0.1.0",
	"description": "Pi extension: TypeSafe's Jev does the reasoning around tool calls (routing, context pre-fetch, result trimming, loop control, guard) so the main model spends its tokens on generation only.",
	"keywords": [
		"pi-package",
		"typesafe",
		"jev",
		"harness",
		"routing"
	],
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"lint": "oxlint",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "tsc --noEmit",
		"test": "bun test *.test.ts",
		"check": "bun run typecheck && bun run lint && bun run format:check && bun test *.test.ts",
		"bench": "node bench.ts"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"dependencies": {
		"pi-native-bridge": "workspace:*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^0.87.1",
		"@earendil-works/pi-tui": "^0.87.1",
		"@ianvs/prettier-plugin-sort-imports": "4.7.1",
		"@oxlint/plugins": "1.78.0",
		"@types/node": "^24.0.0",
		"oxlint": "1.78.0",
		"oxlint-tsgolint": "7.0.2001",
		"prettier": "3.9.6",
		"typescript": "^5.9.0"
	}
}
