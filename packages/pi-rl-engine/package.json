{
	"name": "pi-rl-engine",
	"version": "0.1.0",
	"description": "Verified task feedback for cost-aware model routing in the Pi coding agent JEV harness.",
	"keywords": [
		"pi-package",
		"pi-extension",
		"reinforcement-learning",
		"rl",
		"jev-routing",
		"test-verifier",
		"cost-aware-routing"
	],
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"lint": "oxlint",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "tsc --noEmit",
		"test": "HOME=\"$(mktemp -d)\" bun test",
		"check": "bun run typecheck && bun run lint && bun run format:check && bun run test"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"dependencies": {
		"pi-native-bridge": "workspace:*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^0.87.1",
		"@earendil-works/pi-tui": "^0.87.1",
		"@ianvs/prettier-plugin-sort-imports": "4.7.1",
		"@types/node": "^24.0.0",
		"oxlint": "1.78.0",
		"prettier": "3.9.6",
		"typescript": "^5.9.0"
	}
}
