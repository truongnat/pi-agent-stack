{
	"name": "pi-orchestrator",
	"version": "0.1.0",
	"description": "Multi-agent orchestration and subagent supervisor for the Pi coding agent",
	"keywords": [
		"pi-package",
		"pi-extension",
		"multi-agent",
		"subagent",
		"orchestrator",
		"supervisor"
	],
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"lint": "oxlint",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "tsc --noEmit",
		"test": "NODE_ENV=test bun test",
		"check": "bun run typecheck && bun run lint && bun run format:check && bun test"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.25.2",
		"pi-native-bridge": "workspace:*",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^0.87.1",
		"@earendil-works/pi-tui": "^0.87.1",
		"@types/node": "^24.0.0",
		"oxlint": "1.78.0",
		"prettier": "3.9.6",
		"typebox": "^1.1.2",
		"typescript": "^5.9.0"
	}
}
